    {
      "name": "09 - Tests de Sécurité & Idempotence",
      "description": "Tests de vérification des règles de sécurité (401, 403, anti-escalade, idempotence).",
      "item": [
        {
          "name": "Sécurité 1 : Requête sans cookie -> 401 Unauthorized",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Accès sans session rejeté avec HTTP 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.error).to.include('Authentification requise');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/expenses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "expenses"
              ]
            }
          }
        },
        {
          "name": "Sécurité 2 : Inscription avec 'role: ADMIN' -> Rôle forcé à RESIDENT",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Compte créé avec rôle forcé à RESIDENT (201)\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.role).to.eql('RESIDENT');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Attaquant Escalate\",\n  \"email\": \"escalate.test@syndicpro.tn\",\n  \"password\": \"Attaque123!\",\n  \"confirmPassword\": \"Attaque123!\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Idempotence 1 : Création initiale de l'incident avec clientId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Incident initial créé (code 201 ou 200)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"residence\": \"{{residenceId}}\",\n  \"title\": \"Fuite radiateur hall\",\n  \"description\": \"Signalement avec clientId unique pour test d'idempotence\",\n  \"category\": \"PLUMBING\",\n  \"priority\": \"MEDIUM\",\n  \"clientId\": \"{{testClientId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/incidents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "incidents"
              ]
            }
          }
        },
        {
          "name": "Idempotence 2 : Deuxième envoi avec le MÊME clientId -> Pas de doublon (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Idempotence confirmée : document existant renvoyé avec statut 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.clientId).to.eql(pm.environment.get('testClientId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
